              <seg type="diplomatic-text" rend="unknown">寸 浮中沉／關 浮中沉／尺 浮中沉</seg>
            </ab>
            <ab type="page-feature" subtype="printed-small-text">
              <label>下手圖掌內</label>
              <seg type="diplomatic-text" rend="unknown">左手</seg>
            </ab>
            <ab type="page-feature" subtype="printed-small-text">
              <label>下手圖腕格及左側小字</label>
